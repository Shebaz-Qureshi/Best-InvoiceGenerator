---
import { locales, localeHref } from '../i18n';

interface Props {
  lang: string;
  pagePath: string;
  label: string;
  /** Per-locale full-path overrides (without leading slash, without trailing slash).
   *  e.g. { es: 'es/guides/lista-verificacion-factura' }
   *  When provided, the switcher will navigate to `/${override}/` for that locale.
   */
  langPaths?: Record<string, string>;
}

const { lang, pagePath, label, langPaths = {} } = Astro.props;

const options = locales.map((l) => {
  const href = langPaths[l.code]
    ? '/' + langPaths[l.code] + '/'
    : localeHref(l.code, pagePath);
  return { code: l.code, label: l.label, href };
});
---

<label class="language-switcher relative inline-flex">
  <span class="sr-only">{label}</span>
  <select
    id="langSelect"
    class="bloom-input cursor-pointer py-1.5 pl-3 pr-8 text-xs font-medium"
    aria-label={label}
  >
    {options.map((o) => (
      <option value={o.href} selected={o.code === lang}>{o.label}</option>
    ))}
  </select>
</label>

<script>
  const sel = document.getElementById('langSelect');
  if (sel) {
    sel.addEventListener('change', () => {
      if ((sel as HTMLSelectElement).value) window.location.assign((sel as HTMLSelectElement).value);
    });
  }
</script>
