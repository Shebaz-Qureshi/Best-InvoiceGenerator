---
import { locales, localeHref } from '../i18n';

interface Props {
  lang: string;
  pagePath: string;
  label: string;
}

const { lang, pagePath, label } = Astro.props;
---

<label class="language-switcher relative inline-flex">
  <span class="sr-only">{label}</span>
  <select
    id="langSelect"
    class="bloom-input cursor-pointer py-1.5 pl-3 pr-8 text-xs font-medium"
    aria-label={label}
  >
    {locales.map((l) => (
      <option value={localeHref(l.code, pagePath)} selected={l.code === lang}>{l.label}</option>
    ))}
  </select>
</label>

<script>
  const sel = document.getElementById('langSelect');
  if (sel) {
    sel.addEventListener('change', () => {
      if (sel.value) window.location.assign(sel.value);
    });
  }
</script>
