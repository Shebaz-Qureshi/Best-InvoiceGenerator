---
import BaseLayout from '../layouts/BaseLayout.astro';
import en from '../i18n/en';
---

<BaseLayout
  title="Page Not Found (404) | Best Invoice Generator"
  description="We couldn't find the page you're looking for. Head back to the free online invoice generator and invoice maker to create a professional invoice."
  path="404"
  lang="en"
  t={en}
>
  <section class="flex flex-1 items-center justify-center border-b">
    <div class="mx-auto max-w-xl px-4 py-20 text-center sm:px-6">
      <p class="eyebrow">ERROR 404</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-white sm:text-5xl">Page not found</h1>
      <p class="mt-4 text-sm leading-7 text-zinc-400">
        The page you're looking for doesn't exist, was moved, or the link is out of date. Let's get you back on track.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="button-primary">Create an invoice</a>
        <a href="/about" class="button-secondary">About us</a>
        <a href="/contact" class="button-secondary">Contact us</a>
      </div>
    </div>
  </section>
</BaseLayout>