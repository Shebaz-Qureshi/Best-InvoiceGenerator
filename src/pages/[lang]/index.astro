        </aside>
      </div>

      <!-- SEO Content Section: 800-1200 word article about the invoice generator tool -->
      <section class="content-section border-t" aria-labelledby="invoice-generator-heading">
        <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
          <p class="eyebrow">{t.seoContent.eyebrow}</p>
