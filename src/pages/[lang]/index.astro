    </main>

    <!-- Item Row Template -->
    <template id="itemTemplate">
      <div class="bloom-item-row grid grid-cols-12 gap-2 items-center">
        <div class="col-span-6 max-sm:col-span-12">
          <input class="item-description bloom-input" placeholder={t.tool.itemPlaceholder} />
        </div>
        <div class="col-span-2 max-sm:col-span-3">
          <input class="item-qty bloom-input text-center" type="number" min="0" step="0.5" placeholder={t.tool.qtyPlaceholder} />
        </div>
        <div class="col-span-3 max-sm:col-span-6">
          <input class="item-rate bloom-input text-right" type="number" min="0" step="0.01" placeholder={t.tool.pricePlaceholder} />
        </div>
        <div class="col-span-1 max-sm:col-span-3 flex justify-center">
          <button type="button" class="remove-item text-zinc-400 hover:text-red-500 text-sm font-bold p-1" title="Remove item">✕</button>
        </div>
      </div>
    </template>

    <!-- Main Client Script -->
    <script is:inline src="/saved-invoices.js"></script>
    <script>
      const I18N = JSON.parse(document.getElementById('big-i18n').textContent);
      const $ = (id) => document.getElementById(id);
      const fields = ['currency', 'dueDate', 'invoiceNumber', 'fromAddress', 'toAddress', 'taxRate', 'discountRate', 'shippingAmount', 'memo'];
      const itemsBody = $('itemsBody'), template = $('itemTemplate');
      let logoData = '', coverArtData = '', selectedPreset = 'liquid';

      // Presets Data Mapping
      const presets = {
        liquid: { class: 'bg-gradient-to-r from-teal-500 via-cyan-600 to-blue-700', pattern: 'bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white/20 via-transparent to-black/30' },
        dots: { class: 'bg-gradient-to-r from-blue-900 via-indigo-950 to-slate-900', pattern: 'bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:8px_8px] opacity-40' },
        coral: { class: 'bg-gradient-to-r from-rose-400 via-rose-500 to-pink-600', pattern: 'bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,0.2)_50%,transparent_75%)]' },
        monochrome: { class: 'bg-gradient-to-r from-yellow-300 via-amber-400 to-yellow-600', pattern: 'bg-[repeating-linear-gradient(-45deg,#fde047,#fde047_4px,#f59e0b_4px,#f59e0b_8px)] opacity-80' }
      };

      // Parse URL parameters for prefilled invoice links
      let urlParamsApplied = false;
      function applyUrlParams() {
        const params = new URLSearchParams(window.location.search);
        if (!params.size) return;

        // Simple fields - support both documented names (from, to) and internal names (fromAddress, toAddress)
        const simpleFields = ['fromAddress', 'toAddress', 'currency', 'invoiceNumber', 'discountRate', 'taxRate', 'shippingAmount', 'memo'];
        simpleFields.forEach(f => {
          const v = params.get(f) || params.get(f === 'fromAddress' ? 'from' : f === 'toAddress' ? 'to' : '');
          if (v !== null && v !== '' && $(f)) $(f).value = decodeURIComponent(v);
        });

        // Due date: can be YYYY-MM-DD or +N days
        const due = params.get('dueDate') || params.get('due');
        if (due) {
          if (due.startsWith('+')) {
            const days = parseInt(due.slice(1), 10);
            if (!isNaN(days)) {
              const d = new Date();
              d.setDate(d.getDate() + days);
              $('dueDate').value = d.toISOString().slice(0, 10);
            }
          } else {
            $('dueDate').value = due;
          }
        }

        // Line items: support both single (item, qty, rate) and arrays (item[], qty[], rate[])
        const items = [];
        const item = params.get('item');
        const qty = params.get('qty');
        const rate = params.get('rate');
        if (item) {
          items.push({ description: decodeURIComponent(item), qty: parseFloat(qty) || 1, rate: parseFloat(rate) || 0 });
        }
        const itemArr = params.getAll('item[]');
        const qtyArr = params.getAll('qty[]');
        const rateArr = params.getAll('rate[]');
        itemArr.forEach((it, i) => {
          items.push({ description: decodeURIComponent(it), qty: parseFloat(qtyArr[i]) || 1, rate: parseFloat(rateArr[i]) || 0 });
        });

        if (items.length) {
          itemsBody.innerHTML = '';
          items.forEach(addItem);
          urlParamsApplied = true;
        } else {
          addItem();
        }

        // Cover art preset
        const cover = params.get('coverArt');
        if (cover && presets[cover]) {
          selectedPreset = cover;
          document.querySelectorAll('.preset-card').forEach(b => {
            b.classList.toggle('active', b.dataset.preset === cover);
          });
        }

        // Trigger render to update preview
        render();
      }

      // Set default dates
      const today = new Date(), plus14 = new Date(Date.now() + 12096e5);
      $('dueDate').value = plus14.toISOString().slice(0, 10);

      // Apply URL params (sets invoiceNumber if provided in URL)
      applyUrlParams();

      function money(value) {
        return new Intl.NumberFormat(I18N.lang, {
          style: 'currency',
          currency: $('currency').value || 'USD',
          maximumFractionDigits: 2
        }).format(value || 0);
      }

      function formatDateStr(str) {
        if (!str) return '';
        try {
          const d = new Date(str + 'T00:00:00');
          return d.toLocaleDateString(I18N.lang, { month: 'short', day: 'numeric', year: 'numeric' });
        } catch { return str; }
      }

      function addItem(item = { description: '', qty: '', rate: '' }) {
        const node = template.content.cloneNode(true);
        const row = node.querySelector('.bloom-item-row');
        row.querySelector('.item-description').value = item.description;
        row.querySelector('.item-qty').value = item.qty;
        row.querySelector('.item-rate').value = item.rate || '';
        itemsBody.append(node);
        row.querySelectorAll('input').forEach(x => x.addEventListener('input', render));
        row.querySelector('.remove-item').addEventListener('click', () => {
          if (itemsBody.children.length > 1) {
            row.remove();
            render();
          } else {
            setStatus(I18N.messages.keepOneItem, 'error');
          }
        });
        render();
      }

      function val(id) { return $(id).value.trim(); }

      function data() {
        return {
          ...Object.fromEntries(fields.map(k => [k, val(k)])),
          logoData,
          coverArtData,
          selectedPreset,
          items: [...itemsBody.children].map(r => ({
            description: r.querySelector('.item-description').value,
            qty: +r.querySelector('.item-qty').value || 0,
            rate: +r.querySelector('.item-rate').value || 0
          }))
        };
      }

      function render() {
        const d = data();
        const subtotal = d.items.reduce((s, x) => s + x.qty * x.rate, 0);
        const discount = subtotal * (+d.discountRate || 0) / 100;
        const shipping = +d.shippingAmount || 0;
        const tax = (subtotal - discount) * (+d.taxRate || 0) / 100;
        const total = subtotal - discount + shipping + tax;

        // Render Cover Art
        const coverArtContainer = $('previewCoverArt');
        const coverImg = $('previewCoverImg');
        const coverPattern = $('previewCoverPattern');

        if (d.coverArtData) {
          coverImg.src = d.coverArtData;
          coverImg.classList.remove('hidden');
          coverPattern.className = 'hidden';
          coverArtContainer.className = 'w-full h-24 rounded-xl overflow-hidden mb-6 relative bg-zinc-900';
        } else if (presets[d.selectedPreset]) {
          coverImg.classList.add('hidden');
          coverArtContainer.className = `w-full h-24 rounded-xl overflow-hidden mb-6 relative ${presets[d.selectedPreset].class}`;
          coverPattern.className = `absolute inset-0 ${presets[d.selectedPreset].pattern}`;
        }

        // Render Logo
        if (d.logoData) {
          $('previewLogo').src = d.logoData;
          $('previewLogo').classList.remove('hidden');
        } else {
          $('previewLogo').classList.add('hidden');
        }

        // Document title & Dates
        $('previewDocTitle').textContent = `${I18N.invoiceWord} #${d.invoiceNumber || '001'}`;
        $('previewIssueDate').textContent = `${I18N.issuedWord}: ${formatDateStr(today.toISOString().slice(0, 10))}`;
        $('previewDueDate').textContent = `${I18N.dueWord}: ${formatDateStr(d.dueDate)}`;

        // Addresses
        $('previewFrom').textContent = d.fromAddress || I18N.fromDefault;
        $('previewTo').textContent = d.toAddress || I18N.toDefault;

        // Items table
        $('previewItems').innerHTML = d.items.map(x => `
          <tr>
            <td class="py-2 font-medium text-zinc-800">${escape(x.description) || I18N.itemDefault}</td>
            <td class="py-2 text-center text-zinc-600">${x.qty}</td>
            <td class="py-2 text-right text-zinc-600">${money(x.rate)}</td>
            <td class="py-2 text-right font-medium text-zinc-900">${money(x.qty * x.rate)}</td>
          </tr>
        `).join('');

        // Totals
        $('previewSubtotal').textContent = money(subtotal);

        $('discountRow').classList.toggle('hidden', !discount);
        $('previewDiscount').textContent = `-${money(discount)}`;
        $('discountLabel').textContent = `${I18N.discountWord} (${d.discountRate}%)`;

        $('taxRow').classList.toggle('hidden', !tax);
        $('previewTax').textContent = money(tax);
        $('taxLabel').textContent = `${I18N.taxWord} (${d.taxRate}%)`;

        $('shippingRow').classList.toggle('hidden', !shipping);
        $('previewShipping').textContent = money(shipping);

        $('previewTotal').textContent = money(total);

        // Memo
        $('previewMemo').textContent = d.memo || I18N.memoDefault;
        $('memoBlock').classList.toggle('hidden', !d.memo);
      }

      function escape(s = '') {
        return s.replace(/[&<>'"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[c]));
      }

      function setStatus(message, type = 'success') {
        const s = $('status');
        if (!s) return;
        s.textContent = message;
        s.className = `rounded-full px-3 py-1.5 text-sm font-medium ${type === 'error' ? 'bg-red-950/60 text-red-300' : 'bg-emerald-950/60 text-emerald-300'}`;
      }

      function load(d) {
        if (!d) return;
        fields.forEach(k => { if ($(k) && d[k] !== undefined) $(k).value = d[k] || ''; });
        logoData = d.logoData || '';
        coverArtData = d.coverArtData || '';
        selectedPreset = d.selectedPreset || 'liquid';

        // Update active preset button styling
        document.querySelectorAll('.preset-card').forEach(b => {
          b.classList.toggle('active', b.dataset.preset === selectedPreset);
        });

        // Update optional section toggles based on saved values
        if ($('showTaxToggle')) {
          const showTax = +d.taxRate > 0;
          $('showTaxToggle').checked = showTax;
          $('taxContainer').classList.toggle('hidden', !showTax);
        }
        if ($('showShippingToggle')) {
          const showShipping = +d.shippingAmount > 0;
          $('showShippingToggle').checked = showShipping;
          $('shippingContainer').classList.toggle('hidden', !showShipping);
        }
        if ($('discountContainer')) {
          const showDiscount = +d.discountRate > 0;
          $('discountContainer').classList.toggle('hidden', !showDiscount);
          if ($('discountIcon')) $('discountIcon').textContent = showDiscount ? '-' : '+';
        }

        itemsBody.innerHTML = '';
        if (d.items?.length) {
          d.items.forEach(addItem);
        } else {
          addItem();
        }
        render();
      }
      window.restoreInvoice = load;

      // Event Listeners Initialization
      $('addItem').onclick = () => addItem();
      function loadScript(src) {
        return new Promise((resolve, reject) => {
          const s = document.createElement('script');
          s.src = src;
          s.onload = resolve;
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }

      // html2canvas (bundled in html2pdf 0.14) cannot parse CSS Color 4 values
      // (oklch/oklab/color()). Tailwind v4 emits oklch(), so we convert them to
      // sRGB rgb()/rgba() in html2canvas's onclone hook before rendering.
      function oklabToRgb(L, a, b, alpha) {
        const l_ = L + 0.3963377774 * a + 0.2158037573 * b;
        const m_ = L - 0.1055613458 * a - 0.0638541728 * b;
        const s_ = L - 0.0894841775 * a - 1.2914855480 * b;
        const l = l_ * l_ * l_, mm = m_ * m_ * m_, s = s_ * s_ * s_;
        let r = 4.0767416621 * l - 3.3077115913 * mm + 0.2309699292 * s;
        let g = -1.2684380046 * l + 2.6097574011 * mm - 0.3413193965 * s;
        let bl = -0.0041960863 * l - 0.7034186147 * mm + 1.7076147010 * s;
        const conv = (v) => { v = v <= 0.0031308 ? 12.92 * v : 1.055 * Math.pow(v, 1 / 2.4) - 0.055; return Math.max(0, Math.min(1, v)); };
        const R = Math.round(conv(r) * 255), G = Math.round(conv(g) * 255), B = Math.round(conv(bl) * 255);
        return alpha < 1 ? `rgba(${R},${G},${B},${alpha})` : `rgb(${R},${G},${B})`;
      }
      function colorToRgb(color) {
        color = color.trim();
        const num = (x) => x.endsWith('%') ? parseFloat(x) / 100 : parseFloat(x);
        const alphaOf = (seg) => { const t = seg.trim(); return t.endsWith('%') ? parseFloat(t) / 100 : parseFloat(t); };
        let m = color.match(/^oklch\(([^)]*)\)$/);
        if (m) {
          const seg = m[1].split('/');
          const p = seg[0].trim().split(/\s+/);
          const L = num(p[0]), C = num(p[1]), H = isNaN(num(p[2])) ? 0 : num(p[2]);
          return oklabToRgb(L, C * Math.cos(H * Math.PI / 180), C * Math.sin(H * Math.PI / 180), seg[1] !== undefined ? alphaOf(seg[1]) : 1);
        }
        m = color.match(/^oklab\(([^)]+)\)$/);
        if (m) {
          const seg = m[1].split('/');
          const p = seg[0].trim().split(/\s+/);
          return oklabToRgb(num(p[0]), num(p[1]), num(p[2]), seg[1] !== undefined ? alphaOf(seg[1]) : 1);
        }
        m = color.match(/^color\((srgb|display-p3)\s+([^)]+)\)$/);
        if (m) {
          const p = m[2].trim().split(/\s+/);
          const R = Math.round(Math.max(0, Math.min(1, num(p[0]))) * 255);
          const G = Math.round(Math.max(0, Math.min(1, num(p[1]))) * 255);
          const B = Math.round(Math.max(0, Math.min(1, num(p[2]))) * 255);
          const a = p[3] !== undefined && p[3] !== 'none' ? alphaOf(p[3]) : 1;
          return a < 1 ? `rgba(${R},${G},${B},${a})` : `rgb(${R},${G},${B})`;
        }
        return null;
      }
      function sanitizeCssValue(value) {
        return value.replace(/oklch\([^)]*\)|oklab\([^)]*\)|color\([^)]*\)/g, (m) => { const c = colorToRgb(m); return c || m; });
      }
      function convertPreviewToRgb() {
        const root = $('invoicePreview');
        const snapshot = [];
        for (const el of [root, ...root.querySelectorAll('*')]) {
          const cs = getComputedStyle(el);
          const fixes = {};
          for (let i = 0; i < cs.length; i++) {
            const p = cs[i];
            const v = cs.getPropertyValue(p);
            if (/oklch|oklab|\bcolor\(/.test(v)) { const nv = sanitizeCssValue(v); if (nv !== v) fixes[p] = nv; }
          }
          const keys = Object.keys(fixes);
          if (keys.length) {
            const prev = {};
            for (const p of keys) prev[p] = el.style.getPropertyValue(p);
            for (const p of keys) el.style.setProperty(p, fixes[p]);
            snapshot.push({ el, prev });
          }
        }
        return snapshot;
      }
      function restorePreviewRgb(snapshot) {
        for (const { el, prev } of snapshot) {
          for (const p in prev) {
            if (prev[p] === '') el.style.removeProperty(p);
            else el.style.setProperty(p, prev[p]);
          }
        }
      }
      function whenTabReady(win, timeout) {
        return new Promise((resolve) => {
          if (!win) { resolve(); return; }
          const start = Date.now();
          const check = () => {
            let ok = false;
            try { ok = win.document && win.document.readyState === 'complete'; } catch {}
            if (ok || Date.now() - start > timeout) resolve();
            else setTimeout(check, 100);
          };
          check();
        });
      }

      // Save invoice locally (IndexedDB via saved-invoices.js)
      $('saveInvoice').onclick = async () => {
        const btn = $('saveInvoice');
        const d = data();
        const subtotal = d.items.reduce((s, x) => s + x.qty * x.rate, 0);
        const discount = subtotal * (+d.discountRate || 0) / 100;
        const shipping = +d.shippingAmount || 0;
        const tax = (subtotal - discount) * (+d.taxRate || 0) / 100;
        const now = new Date();
        const firstLine = (v) => (v || '').split('\n').map(s => s.trim()).filter(Boolean)[0] || '';

        const invoiceNumber = d.invoiceNumber || '001';
        const all = await SavedInvoices.getAll();
        const existing = all.find(x => x.invoiceNumber === d.invoiceNumber && x.client === firstLine(d.toAddress) && x.currency === (d.currency || 'USD'));

        const rec = {
          id: '',
          savedAt: now.toISOString(),
          updatedAt: now.toISOString(),
          invoiceNumber,
          client: firstLine(d.toAddress),
          from: firstLine(d.fromAddress),
          currency: d.currency || 'USD',
          dueDate: d.dueDate,
          subtotal, discount, tax, shipping,
          total: subtotal - discount + shipping + tax,
          itemCount: d.items.length,
          status: 'unpaid',
          data: { ...d, invoiceNumber }
        };
        try {
          btn.disabled = true;
          if (existing) {
            rec.id = existing.id;
            rec.savedAt = existing.savedAt;
          } else {
            rec.id = SavedInvoices.newId();
          }
          await SavedInvoices.save(rec);
          setStatus(existing ? (I18N.messages.invoiceUpdated || 'Invoice updated') : (I18N.messages.invoiceSaved || 'Invoice saved'));
        } catch {
          setStatus(I18N.messages.saveFailed || 'Could not save invoice', 'error');
        } finally {
          btn.disabled = false;
        }
      };

      $('downloadPdf').onclick = async () => {
        const btn = $('downloadPdf');
        btn.disabled = true;
        setStatus(I18N.messages.preparingPdf);
        const blankTab = window.open('', '_blank');
        if (blankTab) { try { blankTab.opener = null; } catch {} }
        if (typeof html2pdf === 'undefined') {
          try { await loadScript('/html2pdf.bundle.min.js'); } catch { btn.disabled = false; setStatus(I18N.messages.openingPrintDialog, 'error'); return; }
        }
        try {
          const invoiceId = data().invoiceNumber || '001';
          const now = new Date();
          const pad = (n) => String(n).padStart(2, '0');
          const ts = `${now.getFullYear()}${pad(now.getMonth() + 1)}${pad(now.getDate())}_${pad(now.getHours())}${pad(now.getMinutes())}${pad(now.getSeconds())}`;
          const pdfName = `Invoice_${invoiceId}_${ts}.pdf`;
          const rgbaSnapshot = convertPreviewToRgb();
          let blob;
          try {
            blob = await html2pdf().set({
              margin: 0,
              filename: pdfName,
              image: { type: 'jpeg', quality: 0.98 },
              html2canvas: { scale: 2, useCORS: true, logging: false, backgroundColor: '#ffffff' },
              jsPDF: { unit: 'pt', format: 'a4', orientation: 'portrait' }
            }).from($('invoicePreview')).outputPdf('blob');
          } finally {
            restorePreviewRgb(rgbaSnapshot);
          }

          if (blob.type !== 'application/pdf') {
            blob = new Blob([blob], { type: 'application/pdf' });
          }
          const blobUrl = URL.createObjectURL(blob);

          if (blankTab) { blankTab.location.href = blobUrl; } else if (typeof window.open === 'function') { window.open(blobUrl, '_blank'); }

          const a = document.createElement('a');
          a.href = blobUrl;
          a.download = pdfName;
          a.style.display = 'none';
          document.body.appendChild(a);
          a.click();
          setTimeout(() => document.body.removeChild(a), 0);

          setStatus(I18N.messages.pdfDownloaded);
          const thankYouUrl = (I18N.lang === 'en' ? '/thank-you' : '/' + I18N.lang + '/thank-you');
          await whenTabReady(blankTab, 8000);
          await new Promise((r) => setTimeout(r, 1000));
          window.location.href = thankYouUrl;
        } catch {
          if (blankTab) { try { blankTab.close(); } catch {} }
          window.print();
          setStatus(I18N.messages.usedPrintDialog, 'error');
          btn.disabled = false;
        }
      };
      $('printPreview').onclick = () => {
        window.print();
      };

      // Options dropdown toggle
      $('optionsToggle').onclick = (e) => {
        e.stopPropagation();
        $('optionsMenu').classList.toggle('hidden');
      };
      document.addEventListener('click', () => $('optionsMenu').classList.add('hidden'));
      $('optionsMenu').onclick = (e) => e.stopPropagation();

      $('showTaxToggle').onchange = (e) => {
        $('taxContainer').classList.toggle('hidden', !e.target.checked);
      };
      $('showShippingToggle').onchange = (e) => {
        $('shippingContainer').classList.toggle('hidden', !e.target.checked);
      };

      // Discount toggle button
      $('toggleDiscountBtn').onclick = () => {
        const isHidden = $('discountContainer').classList.toggle('hidden');
        $('discountIcon').textContent = isHidden ? '+' : '-';
        if (isHidden) $('discountRate').value = 0;
        render();
      };

      // Preset Gallery handling
      document.querySelectorAll('.preset-card').forEach(btn => {
        btn.onclick = () => {
          document.querySelectorAll('.preset-card').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          selectedPreset = btn.dataset.preset;
          coverArtData = ''; // Clear custom uploaded image to use preset
          render();
        };
      });

      // Logo & Cover Upload
      $('logoUpload').onchange = e => {
        const f = e.target.files[0];
        if (!f) return;
        if (f.size > 2e6) { setStatus(I18N.messages.logoTooLarge, 'error'); return; }
        const r = new FileReader();
        r.onload = () => { logoData = r.result; render(); };
        r.readAsDataURL(f);
      };

      $('coverArtUpload').onchange = e => {
        const f = e.target.files[0];
        if (!f) return;
        if (f.size > 4e6) { setStatus(I18N.messages.coverTooLarge, 'error'); return; }
        const r = new FileReader();
        r.onload = () => { coverArtData = r.result; render(); };
        r.readAsDataURL(f);
      };

      fields.forEach(k => {
        if ($(k)) {
          $(k).addEventListener('input', render);
          $(k).addEventListener('change', render);
        }
      });

      function decodeInvoiceData(rawB64) {
        if (!rawB64) return null;
        try {
          const cleaned = decodeURIComponent(rawB64).trim().replace(/ /g, '+');
          const jsonStr = decodeURIComponent(escape(atob(cleaned)));
          return JSON.parse(jsonStr);
        } catch (e) {
          console.error('Failed to decode base64 invoice payload:', e);
          return null;
        }
      }

      async function initInvoiceData() {
        try {
          const hashStr = location.hash.slice(1);
          const searchStr = location.search.slice(1);
          const hashParams = new URLSearchParams(hashStr);
          const searchParams = new URLSearchParams(searchStr);

          const id = hashParams.get('id') || searchParams.get('id');
          const invoiceB64 = hashParams.get('invoice') || searchParams.get('invoice');

          if (id && typeof SavedInvoices !== 'undefined' && SavedInvoices.get) {
            const rec = await SavedInvoices.get(id);
            if (rec && rec.data) {
              load(rec.data);
              if (location.hash || location.search) {
                history.replaceState(null, '', location.pathname);
              }
              return;
            }
          }

          if (invoiceB64) {
            const data = decodeInvoiceData(invoiceB64);
            if (data) {
              load(data);
              if (location.hash || location.search) {
                history.replaceState(null, '', location.pathname);
              }
              return;
            }
          }
        } catch (e) {
          console.error('Error in initInvoiceData:', e);
        }

        if (!urlParamsApplied) addItem();
      }

      initInvoiceData();
    </script>

    <!-- Theme switch logic -->
    <script>
      const themeButton = document.getElementById('themeToggle');
      function syncThemeButton() {
        const light = document.documentElement.classList.contains('theme-light');
        themeButton.textContent = light ? '🌙' : '☀️';
        themeButton.setAttribute('aria-label', `Switch to ${light ? 'dark' : 'light'} mode`);
        document.querySelector('meta[name="theme-color"]').setAttribute('content', light ? '#fafafa' : '#09090b');
      }
      themeButton.addEventListener('click', () => {
        const light = document.documentElement.classList.toggle('theme-light');
        const theme = light ? 'light' : 'dark';
        document.documentElement.style.colorScheme = theme;
        try { localStorage.setItem('big-theme', theme); } catch {}
        syncThemeButton();
      });
      syncThemeButton();
    </script>
  </body>
</html>
