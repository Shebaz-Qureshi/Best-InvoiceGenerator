---
import '../../styles/global.css';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import { getTranslation, ogLocales, localePrefix, localeHref } from '../../i18n';
import { locales } from '../../i18n';

export const prerender = true;

export function getStaticPaths() {
  return locales.filter((l) => l.code !== 'en').map((l) => ({ params: { lang: l.code } }));
}

const { lang = 'en' } = Astro.params;
const t = getTranslation(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const siteUrl = 'https://best-invoicegenerator.com';
const canonical = lang === 'en' ? 'https://best-invoicegenerator.com/' : siteUrl + localePrefix(lang) + '/';
const ogLocale = ogLocales[lang] ?? 'en_US';
const allLocales = ['en', 'es', 'fr', 'de', 'it', 'nl', 'pt', 'ar', 'ja'];
const altUrl = (code: string) => siteUrl + localePrefix(code) + '/';

const faqItems = t.faqItems.map((item) => [item.q, item.a] as [string, string]);

const exploreGuidesLabels: Record<string, string> = {
  en: 'Explore invoice guides',
  es: 'Explorar guías de facturación',
  fr: 'Explorer les guides de facturation',
  de: 'Rechnungsleitfäden entdecken',
  it: 'Esplora le guide di fatturazione',
  nl: 'Factuurgidsen ontdekken',
  pt: 'Explorar guias de faturação',
  ar: 'استكشف أدلة الفوترة',
  ja: '請求書ガイドを見る',
};
const exploreGuidesText = exploreGuidesLabels[lang] || 'Explore invoice guides';

const toolJs = {
  lang,
  messages: t.tool.messages,
  invoiceWord: t.tool.invoice,
  issuedWord: t.tool.issued,
  dueWord: t.tool.due,
  discountWord: t.tool.discount,
  taxWord: t.tool.tax,
  fromDefault: t.tool.messages.fromAddress,
  toDefault: t.tool.messages.billToAddress,
  itemDefault: t.tool.messages.serviceOrProduct,
  memoDefault: t.tool.messages.thankYou,
};
const toolJsJson = JSON.stringify(toolJs);

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Best Invoice Generator',
  url: canonical,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Any',
  description: t.seo.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};

const qaPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(([name, text]) => ({
    '@type': 'Question',
    name,
    acceptedAnswer: {
      '@type': 'Answer',
      text: `<p>${text}</p>`,
    },
  })),
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#09090b" />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-EWLF9RN3TX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-EWLF9RN3TX');
    </script>
    <script is:inline>try{const t=localStorage.getItem('big-theme')||((matchMedia('(prefers-color-scheme: light)').matches)?'light':'dark');document.documentElement.classList.toggle('theme-light',t==='light');document.documentElement.style.colorScheme=t;document.querySelector('meta[name="theme-color"]').setAttribute('content',t==='light'?'#fafafa':'#09090b')}catch{}</script>
    <script type="application/json" id="big-i18n" is:inline set:html={toolJsJson}></script>
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Invoice" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="description" content={t.seo.description} />
    <meta name="keywords" content={t.seo.keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Best Invoice Generator" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="canonical" href={canonical} />
    {allLocales.map((code) => (
      <link rel="alternate" hreflang={code} href={altUrl(code)} />
    ))}
    <link rel="alternate" hreflang="x-default" href="https://best-invoicegenerator.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Best Invoice Generator" />
    <meta property="og:title" content={t.seo.title} />
    <meta property="og:description" content={t.seo.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={siteUrl + '/og-image.svg'} />
    <meta property="og:image:secure_url" content={siteUrl + '/og-image.svg'} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.seo.title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@BestInvoiceGen" />
    <meta name="twitter:creator" content="@BestInvoiceGen" />
    <meta name="twitter:title" content={t.seo.title} />
    <meta name="twitter:description" content={t.seo.description} />
    <meta name="twitter:image" content={siteUrl + '/og-image.svg'} />
    <meta name="twitter:image:alt" content={t.seo.title} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)}></script>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(qaPageSchema)}></script>
    <title>{t.seo.title}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to invoice editor</a>
    <main id="main-content" class="app-shell min-h-screen">
      <header class="app-header sticky top-0 z-30 border-b backdrop-blur max-sm:static">
        <div class="relative mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-x-3 gap-y-2 px-3 py-2.5 sm:min-h-16 sm:px-6 sm:py-2">
          <a href={localeHref(lang, '')} class="flex items-center gap-2.5 font-semibold tracking-tight" aria-label={t.header.homeAria}>
            <img src="/favicon.svg" alt="" class="h-7 w-7" width="28" height="28" />
            <span>{t.header.brand}</span>
          </a>
          <div class="flex items-center gap-2">
            <a href={localeHref(lang, 'saved-invoices')} class="nav-link">{t.header.quickLinks.savedInvoices}</a>
            <a href={localeHref(lang, 'guides')} class="nav-link">{t.header.quickLinks.guides || 'Guides'}</a>
            <a href="#faq" class="nav-link">{t.header.quickLinks.faq}</a>
            <LanguageSwitcher lang={lang} pagePath="" label="" />
            <button id="themeToggle" class="button-secondary theme-toggle" type="button" aria-label={t.header.themeToggle} title={t.header.themeToggle}>☀️</button>
            <a href="/ai" class="button-primary text-sm font-semibold px-3 py-1.5" aria-label="Invoice with AI">✨ Invoice with AI</a>
          </div>
        </div>
      </header>

      <div class="mx-auto grid max-w-[1440px] gap-6 px-4 py-6 lg:grid-cols-[minmax(0,1fr)_480px] sm:px-6">
        <!-- Main Form Column (Invoice PDF info) -->
        <section class="space-y-6" aria-label="Invoice editor">
          <form id="invoiceForm" class="space-y-6" onsubmit="return false;" novalidate>
            <!-- Invoice PDF Info Panel -->
            <section id="pdf-info" class="panel rounded-2xl bg-white p-6 shadow-sm dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800">
              <div class="flex items-center justify-between border-b border-zinc-100 dark:border-zinc-800/80 pb-4 mb-5">
                <h2 class="text-lg font-bold tracking-tight text-white">{t.tool.invoicePdfInfo}</h2>
                <div class="relative">
                  <button type="button" id="optionsToggle" class="inline-flex items-center gap-1.5 rounded-lg border border-zinc-200 dark:border-zinc-700 bg-zinc-900/50 hover:bg-zinc-50 px-3 py-1.5 text-xs font-semibold text-white hover:text-white dark:hover:bg-zinc-800 dark:text-white transition-colors options-toggle-btn">
                    {t.tool.options} <span class="text-[10px]">▼</span>
                  </button>
                  <div id="optionsMenu" class="hidden absolute right-0 top-full mt-2 w-48 rounded-xl border border-zinc-200 bg-white p-2 shadow-lg dark:border-zinc-800 dark:bg-zinc-900 z-20">
                    <label class="flex items-center gap-2 px-2 py-1.5 text-xs text-zinc-700 dark:text-zinc-300 cursor-pointer hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md">
                      <input type="checkbox" id="showTaxToggle" class="rounded border-zinc-300" checked /> {t.tool.showTax}
                    </label>
                    <label class="flex items-center gap-2 px-2 py-1.5 text-xs text-zinc-700 dark:text-zinc-300 cursor-pointer hover:bg-zinc-100 dark:hover:bg-zinc-800 rounded-md">
                      <input type="checkbox" id="showShippingToggle" class="rounded border-zinc-300" /> {t.tool.showShipping}
                    </label>
                  </div>
                </div>
              </div>

              <!-- Invoice Branding Panel -->
              <section id="brand" class="border-b border-zinc-100 dark:border-zinc-800/80 pb-5 mb-5">
                <div class="grid grid-cols-2 gap-3 mb-4">
                  <label class="bloom-upload-box cursor-pointer">
                    <input id="logoUpload" type="file" accept="image/*" class="hidden" />
                    <span class="text-base font-normal">+</span>
                    <span>{t.tool.uploadLogo}</span>
                  </label>
                  <label class="bloom-upload-box cursor-pointer">
                    <input id="coverArtUpload" type="file" accept="image/*" class="hidden" />
                    <span class="text-base font-normal">+</span>
                    <span>{t.tool.uploadCoverArt}</span>
                  </label>
                </div>

                <!-- Cover Art Presets Carousel/Gallery -->
                <div>
                  <p class="text-[11px] font-semibold text-zinc-400 dark:text-zinc-200 uppercase tracking-wider mb-2">{t.tool.presetArtwork}</p>
                  <div class="grid grid-cols-4 gap-2" id="presetGallery">
                    <button type="button" class="preset-card group active" data-preset="liquid" title={t.tool.presetLiquid}>
                      <div class="h-12 w-full rounded-lg bg-gradient-to-r from-teal-500 via-cyan-600 to-blue-700 opacity-90 transition group-hover:opacity-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white/20 via-transparent to-black/30"></div>
                      </div>
                    </button>
                    <button type="button" class="preset-card group" data-preset="dots" title={t.tool.presetDots}>
                      <div class="h-12 w-full rounded-lg bg-gradient-to-r from-blue-900 via-indigo-950 to-slate-900 opacity-90 transition group-hover:opacity-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:8px_8px] opacity-40"></div>
                      </div>
                    </button>
                    <button type="button" class="preset-card group" data-preset="coral" title={t.tool.presetCoral}>
                      <div class="h-12 w-full rounded-lg bg-gradient-to-r from-rose-400 via-rose-500 to-pink-600 opacity-90 transition group-hover:opacity-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-[linear-gradient(45deg,transparent_25%,rgba(255,255,255,0.2)_50%,transparent_75%)]"></div>
                      </div>
                    </button>
                    <button type="button" class="preset-card group" data-preset="monochrome" title={t.tool.presetMonochrome}>
                      <div class="h-12 w-full rounded-lg bg-gradient-to-r from-yellow-300 via-amber-400 to-yellow-600 opacity-90 transition group-hover:opacity-100 overflow-hidden relative">
                        <div class="absolute inset-0 bg-[repeating-linear-gradient(-45deg,#fde047,#fde047_4px,#f59e0b_4px,#f59e0b_8px)] opacity-80"></div>
                      </div>
                    </button>
                  </div>
                </div>
              </section>

              <!-- Top Settings Grid -->
              <div class="grid grid-cols-1 gap-3 sm:grid-cols-3 mb-5">
                <div class="floating-field">
                  <span class="floating-label">{t.tool.currency}</span>
                  <select id="currency" class="bloom-input">
                    <option value="USD">USD ($) – US Dollar</option>
                    <option value="EUR">EUR (€) – Euro</option>
                    <option value="GBP">GBP (£) – British Pound</option>
                    <option value="INR">INR (₹) – Indian Rupee</option>
                    <option value="CAD">CAD ($) – Canadian Dollar</option>
                    <option value="AUD">AUD ($) – Australian Dollar</option>
                    <option value="JPY">JPY (¥) – Japanese Yen</option>
                    <option value="CNY">CNY (¥) – Chinese Yuan</option>
                    <option value="TRY">TRY (₺) – Turkish Lira</option>
                    <option value="KRW">KRW (₩) – South Korean Won</option>
                    <option value="HKD">HKD ($) – Hong Kong Dollar</option>
                    <option value="SGD">SGD ($) – Singapore Dollar</option>
                    <option value="NZD">NZD ($) – New Zealand Dollar</option>
                    <option value="AED">AED (د.إ) – UAE Dirham</option>
                    <option value="SAR">SAR (ر.س) – Saudi Riyal</option>
                    <option value="QAR">QAR (ر.ق) – Qatari Riyal</option>
                    <option value="KWD">KWD (د.ك) – Kuwaiti Dinar</option>
                    <option value="OMR">OMR (ر.ع.) – Omani Rial</option>
                    <option value="BHD">BHD (د.ب) – Bahraini Dinar</option>
                    <option value="IQD">IQD (ع.د) – Iraqi Dinar</option>
                    <option value="IRR">IRR (﷼) – Iranian Rial</option>
                    <option value="DZD">DZD (د.ج) – Algerian Dinar</option>
                    <option value="MAD">MAD (د.م.) – Moroccan Dirham</option>
                    <option value="TND">TND (د.ت) – Tunisian Dinar</option>
                    <option value="EGP">EGP (E£) – Egyptian Pound</option>
                    <option value="KES">KES (KSh) – Kenyan Shilling</option>
                    <option value="UGX">UGX (USh) – Ugandan Shilling</option>
                    <option value="TZS">TZS (TSh) – Tanzanian Shilling</option>
                    <option value="GHS">GHS (GH₵) – Ghanaian Cedi</option>
                    <option value="ETB">ETB (Br) – Ethiopian Birr</option>
                    <option value="NGN">NGN (₦) – Nigerian Naira</option>
                    <option value="XOF">XOF (CFA) – West African CFA Franc</option>
                    <option value="XAF">XAF (FCFA) – Central African CFA Franc</option>
                    <option value="MUR">MUR (Rs) – Mauritian Rupee</option>
                    <option value="SCR">SCR (SR) – Seychellois Rupee</option>
                    <option value="AFN">AFN (؋) – Afghan Afghani</option>
                    <option value="PLN">PLN (zł) – Polish Zloty</option>
                    <option value="RUB">RUB (₽) – Russian Ruble</option>
                    <option value="CZK">CZK (Kč) – Czech Koruna</option>
                    <option value="HUF">HUF (Ft) – Hungarian Forint</option>
                    <option value="RON">RON (lei) – Romanian Leu</option>
                    <option value="BGN">BGN (лв) – Bulgarian Lev</option>
                    <option value="SEK">SEK (kr) – Swedish Krona</option>
                    <option value="NOK">NOK (kr) – Norwegian Krone</option>
                    <option value="DKK">DKK (kr) – Danish Krone</option>
                    <option value="ISK">ISK (kr) – Icelandic Krona</option>
                    <option value="VND">VND (₫) – Vietnamese Dong</option>
                    <option value="THB">THB (฿) – Thai Baht</option>
                    <option value="MYR">MYR (RM) – Malaysian Ringgit</option>
                    <option value="PHP">PHP (₱) – Philippine Peso</option>
                    <option value="IDR">IDR (Rp) – Indonesian Rupiah</option>
                    <option value="MMK">MMK (Ks) – Myanmar Kyat</option>
                    <option value="LKR">LKR (Rs) – Sri Lankan Rupee</option>
                    <option value="NPR">NPR (Rs) – Nepalese Rupee</option>
                    <option value="MNT">MNT (₮) – Mongolian Tögrög</option>
                    <option value="MVR">MVR (Rf) – Maldivian Rufiyaa</option>
                    <option value="BND">BND ($) – Brunei Dollar</option>
                    <option value="CHF">CHF (CHF) – Swiss Franc</option>
                    <option value="ZAR">ZAR (R) – South African Rand</option>
                    <option value="BRL">BRL (R$) – Brazilian Real</option>
                    <option value="MXN">MXN ($) – Mexican Peso</option>
                    <option value="ARS">ARS ($) – Argentine Peso</option>
                    <option value="CLP">CLP ($) – Chilean Peso</option>
                    <option value="COP">COP ($) – Colombian Peso</option>
                    <option value="PEN">PEN (S/) – Peruvian Sol</option>
                    <option value="UYU">UYU ($U) – Uruguayan Peso</option>
                    <option value="BOB">BOB (Bs.) – Bolivian Boliviano</option>
                    <option value="PYG">PYG (₲) – Paraguayan Guaraní</option>
                  </select>
                </div>

                <div class="floating-field">
                  <span class="floating-label">{t.tool.dueDate}</span>
                  <input id="dueDate" type="date" class="bloom-input" />
                </div>

                <div class="floating-field">
                  <span class="floating-label">{t.tool.invoiceNumber}</span>
                  <input id="invoiceNumber" class="bloom-input font-medium" placeholder={t.tool.invoiceNumberPlaceholder} />
                </div>
              </div>

              <!-- Address Side-by-Side Textareas -->
              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 mb-6">
                <div>
                  <textarea id="fromAddress" rows="4" class="bloom-textarea" placeholder={t.tool.fromPlaceholder}></textarea>
                </div>
                <div>
                  <textarea id="toAddress" rows="4" class="bloom-textarea" placeholder={t.tool.toPlaceholder}></textarea>
                </div>
              </div>

              <!-- Line Items Section -->
              <div class="bloom-items-container mb-5">
                <div class="bloom-items-header">
                  <span class="col-span-6">{t.tool.items}</span>
                  <span class="col-span-2 text-center">{t.tool.qty}</span>
                  <span class="col-span-3 text-right">{t.tool.rate}</span>
                  <span class="col-span-1"></span>
                </div>

                <div id="itemsBody" class="space-y-3 p-1"></div>

                <button type="button" id="addItem" class="bloom-add-item-btn mt-3">
                  {t.tool.addItem}
                </button>
              </div>

              <!-- Discount, Shipping & Memo Footer -->
              <div class="space-y-4 pt-2">
                <div class="flex items-center justify-between">
                  <button type="button" id="toggleDiscountBtn" class="text-xs font-semibold text-zinc-600 hover:text-zinc-900 dark:text-white dark:hover:text-white flex items-center gap-1">
                    <span id="discountIcon">+</span> {t.tool.addDiscount}
                  </button>
                  <div id="discountContainer" class="hidden flex items-center gap-2">
                    <label for="discountRate" class="text-xs font-medium text-zinc-500 dark:text-zinc-100">{t.tool.discountPercent}</label>
                    <input id="discountRate" type="number" min="0" max="100" step="0.1" value="0" class="bloom-input w-20 py-1 text-xs" />
                  </div>
                </div>

                <div id="taxContainer" class="flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800/60 pt-3">
                  <span class="text-xs font-medium text-zinc-500 dark:text-zinc-100">{t.tool.taxRate}</span>
                  <input id="taxRate" type="number" min="0" max="100" step="0.1" value="0" class="bloom-input w-24 py-1 text-xs" />
                </div>

                <div id="shippingContainer" class="hidden flex items-center justify-between border-t border-zinc-100 dark:border-zinc-800/60 pt-3">
                  <span class="text-xs font-medium text-zinc-500 dark:text-zinc-100">{t.tool.shippingAmount}</span>
                  <input id="shippingAmount" type="number" min="0" step="0.01" value="0" class="bloom-input w-28 py-1 text-xs" />
                </div>

                <div class="floating-field pt-2">
                  <span class="floating-label">{t.tool.memo}</span>
                  <textarea id="memo" rows="2" class="bloom-textarea text-xs" placeholder={t.tool.messages.thankYou}>{t.tool.messages.thankYou}</textarea>
                </div>
              </div>
            </section>

          </form>
        </section>

        <!-- Right Column (Live PDF Preview) -->
        <aside class="space-y-6 pr-1" aria-label="PDF preview">
          <!-- Live PDF Preview Panel -->
          <section id="preview-panel" class="panel p-0 overflow-hidden rounded-2xl border border-zinc-200 dark:border-zinc-800 bg-zinc-100 dark:bg-zinc-950">
            <div class="flex items-center justify-between bg-white dark:bg-zinc-900 px-4 py-3 border-b border-zinc-200 dark:border-zinc-800">
              <span class="flex items-center gap-2 text-xs font-bold text-zinc-800 dark:text-zinc-200">
                <span class="live-dot"></span> {t.tool.pdfPreview}
              </span>
              <button id="printPreview" class="text-xs font-semibold text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100 transition-colors">
                {t.tool.printExport}
              </button>
            </div>

            <!-- PDF Document Sheet -->
            <article id="invoicePreview" class="invoice-paper bg-white text-zinc-900 p-4 sm:p-6 shadow-xl min-h-[380px] text-xs flex flex-col justify-between">
              <div>
                <!-- Cover Art Banner Header -->
                <div id="previewCoverArt" class="w-full h-16 rounded-xl overflow-hidden mb-4 bg-gradient-to-r from-teal-500 via-cyan-600 to-blue-700 relative">
                  <img id="previewCoverImg" class="hidden w-full h-full object-cover" alt="Invoice cover art" />
                  <div id="previewCoverPattern" class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-white/20 via-transparent to-black/30"></div>
                </div>

                <!-- Document Info & Logo Header -->
                <div class="flex items-start justify-between gap-4 mb-5">
                  <div>
                    <img id="previewLogo" alt="Business logo" class="hidden max-h-12 max-w-32 object-contain mb-3" />
                  </div>
                  <div class="text-right">
                    <h2 id="previewDocTitle" class="text-xl font-bold tracking-tight text-zinc-900">Invoice #001</h2>
                    <p id="previewIssueDate" class="text-[11px] text-zinc-500 mt-1">Issued: Aug 03, 2026</p>
                    <p id="previewDueDate" class="text-[11px] font-medium text-zinc-700">Due: Aug 17, 2026</p>
                  </div>
                </div>

                <!-- From and To Blocks -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-8 mb-5 pb-4 border-b border-zinc-100">
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">{t.tool.fromLabel}</p>
                    <p id="previewFrom" class="whitespace-pre-line text-xs font-normal text-zinc-700 leading-relaxed"></p>
                  </div>
                  <div>
                    <p class="text-[10px] font-bold uppercase tracking-wider text-zinc-400 mb-1">{t.tool.toLabel}</p>
                    <p id="previewTo" class="whitespace-pre-line text-xs font-normal text-zinc-700 leading-relaxed"></p>
                  </div>
                </div>

                <!-- Items Table -->
                <table class="w-full text-xs mb-4">
                  <thead>
                    <tr class="border-b border-zinc-900 text-[10px] font-bold tracking-wider text-zinc-500 uppercase">
                      <th class="py-2 text-left">{t.tool.itemHeader}</th>
                      <th class="py-2 text-center w-12 sm:w-16">{t.tool.qty}</th>
                      <th class="py-2 text-right w-20 sm:w-24">{t.tool.rate}</th>
                      <th class="py-2 text-right w-20 sm:w-24">{t.tool.amountHeader}</th>
                    </tr>
                  </thead>
                  <tbody id="previewItems" class="divide-y divide-zinc-100"></tbody>
                </table>
              </div>

              <!-- Totals & Memo Section -->
              <div>
                <div class="ml-auto w-full max-w-[220px] space-y-1.5 text-xs pt-3 border-t border-zinc-200">
                  <div class="flex justify-between text-zinc-500">
                    <span>{t.tool.subtotal}</span>
                    <span id="previewSubtotal" class="font-medium text-zinc-800">$0.00</span>
                  </div>
                  <div id="discountRow" class="hidden flex justify-between text-zinc-500">
                    <span id="discountLabel">{t.tool.discount}</span>
                    <span id="previewDiscount" class="text-emerald-600">-$0.00</span>
                  </div>
                  <div id="taxRow" class="hidden flex justify-between text-zinc-500">
                    <span id="taxLabel">{t.tool.tax}</span>
                    <span id="previewTax" class="font-medium text-zinc-800">$0.00</span>
                  </div>
                  <div id="shippingRow" class="hidden flex justify-between text-zinc-500">
                    <span>{t.tool.shipping}</span>
                    <span id="previewShipping" class="font-medium text-zinc-800">$0.00</span>
                  </div>
                  <div class="flex justify-between text-sm font-bold text-zinc-900 pt-2 border-t border-zinc-900">
                    <span>{t.tool.total}</span>
                    <span id="previewTotal">$0.00</span>
                  </div>
                </div>

                <!-- Footer Memo -->
                <div id="memoBlock" class="mt-5 pt-4 border-t border-zinc-100">
                  <p class="text-[10px] font-bold text-zinc-400 uppercase tracking-wider mb-1">{t.tool.memoLabel}</p>
                  <p id="previewMemo" class="text-xs text-zinc-600 italic">Thank you for your business!</p>
