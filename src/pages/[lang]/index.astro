      <!-- FAQ Section -->
      <section id="faq" class="faq-section border-t" aria-labelledby="faq-heading">
        <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
          <p class="eyebrow">{t.faq.eyebrow}</p>
          <h2 id="faq-heading" class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.faq.heading}</h2>
