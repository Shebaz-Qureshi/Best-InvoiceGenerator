---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslation, localeHref } from '../../i18n';
import { locales } from '../../i18n';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang = 'en' } = Astro.params;
const t = getTranslation(lang);
---

<BaseLayout
  title={t.thankYou.metaTitle}
  description={t.thankYou.metaDescription}
  path="thank-you"
  lang={lang}
  t={t}
>
  <section class="border-b">
    <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-16 text-center sm:px-6 sm:py-24">
      <span class="mb-6 grid h-20 w-20 place-items-center rounded-full bg-emerald-500/15 text-4xl" aria-hidden="true">✓</span>
      <p class="eyebrow">{t.thankYou.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.thankYou.heading}</h1>
      <p class="mt-4 max-w-xl text-sm leading-7 text-zinc-400 sm:text-base">{t.thankYou.intro}</p>

      <div class="mt-10 flex w-full flex-col items-stretch gap-4 sm:w-auto sm:flex-row sm:items-center sm:gap-4">
        <a href={localeHref(lang, '')} class="btn-download-pdf flex-1 px-8 py-4 text-center sm:flex-none">
          {t.thankYou.generateAnother}
        </a>
        <a href={localeHref(lang, '')} class="button-secondary inline-flex flex-1 items-center justify-center rounded-lg px-8 py-4 text-center sm:flex-none">
          {t.thankYou.backHome}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
