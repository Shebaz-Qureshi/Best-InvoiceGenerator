---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslation, localeHref } from '../../i18n';
import { locales } from '../../i18n';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang = 'en' } = Astro.params;
const t = getTranslation(lang);
---

<BaseLayout
  title={t.faq.metaTitle}
  description={t.faq.metaDescription}
  path="faq"
  lang={lang}
  t={t}
>
  <section class="border-b">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow">{t.faq.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.faq.heading}</h1>
      <p class="mt-4 text-sm leading-7 text-zinc-400">{t.faq.intro}</p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <dl class="space-y-6 text-sm leading-7 text-zinc-400">
        {t.faqItems.map((item) => (
          <div class="border-b border-zinc-800 pb-6 last:border-b-0">
            <dt class="text-base font-semibold text-white">{item.q}</dt>
            <dd class="mt-2">{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>
