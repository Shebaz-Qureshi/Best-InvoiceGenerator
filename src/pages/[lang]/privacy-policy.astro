---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslation, localeHref } from '../../i18n';
import { locales } from '../../i18n';

export function getStaticPaths() {
  return locales.map((l) => ({ params: { lang: l.code } }));
}

const { lang = 'en' } = Astro.params;
const t = getTranslation(lang);
const updated = new Intl.DateTimeFormat(lang, { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date());
---

<BaseLayout
  title={t.privacy.metaTitle}
  description={t.privacy.metaDescription}
  path="privacy-policy"
  lang={lang}
  t={t}
>
  <section class="border-b">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow">{t.privacy.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.privacy.heading}</h1>
      <p class="mt-4 text-sm leading-7 text-zinc-400">
        {t.privacy.lastUpdated}
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <article class="text-sm leading-7 text-zinc-400">
        {t.privacy.sections.filter((_, index) => index !== 2).map((s) => (
          <div class="mt-10 first:mt-0">
            <h2 class="text-xl font-semibold tracking-tight text-white">{s.heading}</h2>
            {s.body.map((p) => <p class="mt-3">{p}</p>)}
          </div>
        ))}

        <div class="mt-10">
          <h2 class="text-xl font-semibold tracking-tight text-white">Advertising &amp; cookies</h2>
          <p class="mt-3">We use Google Analytics to understand aggregate site usage, such as pages visited and general device or browser information. Google Analytics may use cookies or similar technologies. We do not intentionally send the invoice information you enter—such as client details, addresses, rates, or line items—to Google Analytics.</p>
          <p class="mt-3">This site does not currently display Google-served ads. If Google-served ads, including AdSense, are enabled in the future, Google and its partners may use cookies or local storage to measure ad performance, limit fraud, and, where permitted and with the required consent, personalize advertising.</p>
          <p class="mt-3">Where consent is legally required, we will present a consent message before using cookies or local storage for advertising personalization. You can also manage advertising preferences through <a href="https://myadcenter.google.com/" rel="external noopener noreferrer" target="_blank" class="font-medium text-white underline decoration-zinc-600 underline-offset-4 hover:decoration-white">Google’s My Ad Center</a> and review Google Analytics opt-out options at <a href="https://tools.google.com/dlpage/gaoptout" rel="external noopener noreferrer" target="_blank" class="font-medium text-white underline decoration-zinc-600 underline-offset-4 hover:decoration-white">Google Analytics Opt-out</a>.</p>
          <p class="mt-3">Your browser settings can block or delete cookies and local storage. Doing so may affect saved drafts, theme preferences, consent choices, or how the site functions. You can contact us with privacy questions or to ask about your available choices.</p>
        </div>

        <p class="mt-10">
          {t.privacy.contact} <a href={localeHref(lang, 'contact')} class="font-medium text-white underline decoration-zinc-600 underline-offset-4 hover:decoration-white">{t.privacy.reachOut}</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
