---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslation, locales } from '../../../i18n';
import { getGuidesForLocale, getHubMetaForLocale } from '../../../data/guides-multilingual';

export function getStaticPaths() {
  return locales.filter((l) => l.code !== 'en').map((l) => ({ params: { lang: l.code } }));
}

const { lang = 'en' } = Astro.params;
const t = getTranslation(lang);
const meta = getHubMetaForLocale(lang);
const guidesList = getGuidesForLocale(lang);
const guideHref = (guide: (typeof guidesList)[number]) =>
  lang === 'pt' ? `/pt/guides/${guide.slug}/` : guide.url;

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: meta.title,
  itemListElement: guidesList.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: guideHref(guide).startsWith('http') ? guideHref(guide) : `https://best-invoicegenerator.com${guideHref(guide)}`,
    name: guide.title,
  })),
};
---

<BaseLayout title={meta.title} description={meta.description} path="guides" lang={lang} t={t} hideLangSwitcher={false} localized={true}>
  <section class="border-b border-zinc-800">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow">{meta.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-5xl">{meta.heading}</h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-zinc-400">{meta.intro}</p>
      <a href={`/${lang}/`} class="mt-8 inline-flex items-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-zinc-200">
        {meta.cta} <span aria-hidden="true" class="ml-2">→</span>
      </a>
    </div>
  </section>

  <section aria-labelledby="guide-library">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">{meta.libraryEyebrow}</p>
          <h2 id="guide-library" class="mt-2 text-2xl font-semibold tracking-tight text-white">{meta.libraryHeading}</h2>
        </div>
        <p class="max-w-md text-sm leading-6 text-zinc-400">{meta.librarySubtitle}</p>
      </div>
      <div class="mt-8 space-y-4">
        {guidesList.map((guide) => (
          <article>
            <a href={guideHref(guide)} class="group block rounded-2xl border border-zinc-800 bg-zinc-950 p-6 outline-none transition hover:-translate-y-0.5 hover:border-zinc-600 focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-zinc-950">
              <div class="flex items-center justify-between gap-4 text-xs text-zinc-500">
                <span class="font-medium text-zinc-300">{guide.category}</span>
                <span>{guide.readingTime}</span>
              </div>
              <h3 class="mt-5 text-xl font-semibold tracking-tight text-white group-hover:text-indigo-400">
                {guide.title}
              </h3>
              <p class="mt-3 text-sm leading-7 text-zinc-400">{guide.summary}</p>
              <div class="mt-6 flex items-center justify-end border-t border-zinc-800 pt-4 text-xs text-zinc-500">
                <span class="font-medium text-white transition group-hover:text-indigo-400 inline-flex items-center gap-1.5">
                {meta.readGuide} <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
                </span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-zinc-800 bg-zinc-950/60">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <p class="text-sm leading-7 text-zinc-400 dark:text-zinc-300 editorial-note">{meta.editorialNote}</p>
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)}></script>
</BaseLayout>
