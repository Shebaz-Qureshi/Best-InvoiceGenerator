<script>
  // Copy prompt button
  const copyPromptBtn = document.getElementById('copyPromptBtn');
  const copyPromptLabel = document.getElementById('copyPromptLabel');
  const aiPromptText = document.getElementById('aiPromptText') as HTMLTextAreaElement;

  copyPromptBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(aiPromptText.value);
      if (copyPromptLabel) {
        copyPromptLabel.textContent = '✓ Copied!';
        setTimeout(() => { copyPromptLabel.textContent = 'Copy prompt'; }, 2000);
      }
    } catch {
      aiPromptText.select();
      document.execCommand('copy');
    }
  });

  // Copy MCP URL button
  const copyMcpBtn = document.getElementById('copyMcpBtn');
  const copyMcpLabel = document.getElementById('copyMcpLabel');
  const mcpInput = document.getElementById('mcpServerUrl') as HTMLInputElement;

  copyMcpBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(mcpInput.value);
      if (copyMcpLabel) {
        copyMcpLabel.textContent = '✓ Copied!';
        setTimeout(() => { copyMcpLabel.textContent = 'Copy'; }, 2000);
      }
    } catch {
      mcpInput.select();
      document.execCommand('copy');
    }
  });
</script>
