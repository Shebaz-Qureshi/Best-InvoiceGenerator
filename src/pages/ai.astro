---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslation } from '../i18n';

const lang = 'en';
const t = getTranslation(lang);

const siteUrl = 'https://best-invoicegenerator.com';
const aiMdUrl = `${siteUrl}/ai-instructions.html`;
const aiPrompt = `I want to create an invoice in Best Invoice Generator. Read ${aiMdUrl} and follow those instructions. Ask me for the details you need—such as who I'm billing, what work or items to include, quantities or hours, rates or prices, due date, and currency—then create a prefilled Best Invoice Generator link I can open and review.`;
const encodedPrompt = encodeURIComponent(aiPrompt);

const aiTools = [
  {
    name: 'ChatGPT',
    href: `https://chatgpt.com/?q=${encodedPrompt}`,
    color: '#10a37f',
    letter: 'G',
    desc: 'Open in ChatGPT',
  },
  {
    name: 'Claude',
    href: `https://claude.ai/new?q=${encodedPrompt}`,
    color: '#d4703a',
    letter: 'C',
    desc: 'Open in Claude',
  },
  {
    name: 'Gemini',
    href: `https://gemini.google.com/app?q=${encodedPrompt}`,
    color: '#4285f4',
    letter: 'G',
    desc: 'Open in Gemini',
  },
  {
    name: 'Grok',
    href: `https://grok.com/?q=${encodedPrompt}`,
    color: '#ffffff',
    letter: 'X',
    desc: 'Open in Grok',
  },
  {
    name: 'Perplexity',
    href: `https://www.perplexity.ai/search?q=${encodedPrompt}`,
    color: '#20b2aa',
    letter: 'P',
    desc: 'Open in Perplexity',
  },
];

const features = [
  {
    icon: '🔓',
    title: 'No account required',
    body: 'Generate a prefilled invoice link and open it instantly—no sign-up, no login.',
  },
  {
    icon: '👁️',
    title: 'You review first',
    body: 'AI prepares the draft. You open it, check every detail, and decide what to finalize.',
  },
  {
    icon: '📄',
    title: 'All document types',
    body: 'Invoices, quotes, estimates, receipts, credit notes, purchase orders and more.',
  },
  {
    icon: '🤖',
    title: 'Any AI assistant',
    body: 'Works with ChatGPT, Claude, Gemini, Grok, Perplexity—or any assistant you prefer.',
  },
];

const steps = [
  {
    icon: '💬',
    title: 'Describe your invoice',
    body: 'Tell your AI assistant who you\'re billing, the work done, hours or quantities, your rate, and when payment is due.',
    example: '"Invoice Acme Corp for 10 hours of web dev at $120/hr, due in 30 days, USD."',
  },
  {
    icon: '🔗',
    title: 'AI builds the link',
    body: 'Your assistant creates a prefilled Best Invoice Generator URL with all the details already filled in.',
  },
  {
    icon: '✅',
    title: 'Review & finalize',
    body: 'Open the link, check every field, make any changes, and download or send your professional invoice.',
  },
];
---

<BaseLayout
  title="Invoice with AI | Best Invoice Generator"
  description="Create professional invoices in seconds with AI. Tell ChatGPT, Claude, Gemini, or any AI assistant what you need and get a prefilled invoice instantly. No account required."
  path="ai"
  lang={lang}
  t={t}
  localized={false}
>

  <!-- ░░░ HERO ░░░ -->
  <section class="ai-hero relative overflow-hidden">
    <!-- Animated mesh background -->
    <div class="ai-hero-mesh" aria-hidden="true">
      <div class="mesh-blob mesh-blob-1"></div>
      <div class="mesh-blob mesh-blob-2"></div>
      <div class="mesh-blob mesh-blob-3"></div>
    </div>

    <div class="relative mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-28 text-center">
      <!-- Badge -->
      <div class="ai-badge inline-flex items-center gap-2 mb-6">
        <span class="ai-badge-dot"></span>
        <span>AI Invoice Generator</span>
      </div>

      <h1 class="ai-hero-title">
        Create Invoices in<br />
        <span class="ai-gradient-text">Seconds with AI</span>
      </h1>

      <p class="ai-hero-sub mt-6 mx-auto max-w-2xl">
        Just tell your favourite AI assistant what you're billing for. It builds a prefilled invoice link—no account, no form-filling, no friction.
      </p>

      <!-- Quick-launch AI buttons -->
      <div class="ai-hero-launchers mt-10 flex flex-wrap justify-center gap-3">
        {aiTools.map((tool) => (
          <a
            href={tool.href}
            target="_blank"
            rel="noopener noreferrer"
            class="ai-hero-btn"
            aria-label={`Create invoice with ${tool.name}`}
          >
            <span class="ai-tool-avatar" style={`--tool-color: ${tool.color}`}>{tool.letter}</span>
            <span>{tool.name}</span>
            <svg class="ai-hero-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ))}
      </div>

      <p class="mt-5 text-xs" style="color: var(--muted)">No account required · Review before finalizing · Works with any AI</p>
    </div>
  </section>

  <!-- ░░░ ANIMATED CHAT DEMO ░░░ -->
  <section class="ai-chat-section border-t" aria-label="AI conversation example">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <p class="eyebrow text-center mb-3">See it in action</p>
      <h2 class="ai-section-title text-center">A conversation that becomes an invoice</h2>

      <div class="ai-chat-window mt-10">
        <div class="ai-chat-topbar">
          <span class="chat-dot" style="background:#ff5f56"></span>
          <span class="chat-dot" style="background:#ffbd2e"></span>
          <span class="chat-dot" style="background:#27c93f"></span>
          <span class="ai-chat-label">AI Invoice Assistant</span>
        </div>

        <div class="ai-chat-body" id="chatBody">
          <div class="chat-msg chat-msg-ai chat-line-1">
            <div class="chat-avatar-ai">🤖</div>
            <div class="chat-bubble chat-bubble-ai">
              Hi! I'm ready to create your invoice. Who are you billing and what for?
            </div>
          </div>

          <div class="chat-msg chat-msg-user chat-line-2">
            <div class="chat-bubble chat-bubble-user">
              Invoice Acme Corp for 10 hours of web design at $150/hr. Due in 30 days.
            </div>
          </div>

          <div class="chat-msg chat-msg-ai chat-line-3">
            <div class="chat-avatar-ai">🤖</div>
            <div class="chat-bubble chat-bubble-ai">
              Got it! What currency should I use?
            </div>
          </div>

          <div class="chat-msg chat-msg-user chat-line-4">
            <div class="chat-bubble chat-bubble-user">USD please</div>
          </div>

          <div class="chat-msg chat-msg-ai chat-line-5">
            <div class="chat-avatar-ai">🤖</div>
            <div class="chat-bubble chat-bubble-ai">
              ✅ Here's your prefilled invoice link — open it to review and finalize:
              <a class="chat-link" href="/" aria-label="Example prefilled invoice link">
                🔗 best-invoicegenerator.com/?to=Acme+Corp&item=Web+Design&qty=10&rate=150...
              </a>
              <span class="chat-tag">$1,500.00 · Due in 30 days · USD</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ░░░ HOW IT WORKS ░░░ -->
  <section class="border-t" aria-labelledby="how-it-works-heading">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="eyebrow text-center mb-3">How it works</p>
      <h2 id="how-it-works-heading" class="ai-section-title text-center">Three steps to a finished invoice</h2>

      <div class="ai-steps-grid mt-12">
        {steps.map((step, i) => (
          <div class="ai-step-card">
            <div class="ai-step-icon">{step.icon}</div>
            <div class="ai-step-num">Step {i + 1}</div>
            <h3 class="ai-step-title">{step.title}</h3>
            <p class="ai-step-body">{step.body}</p>
            {step.example && (
              <blockquote class="ai-step-example">{step.example}</blockquote>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░░ AI LAUNCHER GRID ░░░ -->
  <section class="border-t ai-launchers-section" aria-labelledby="launchers-heading">
    <div class="mx-auto max-w-4xl px-4 py-16 sm:px-6">
      <p class="eyebrow text-center mb-3">Launch</p>
      <h2 id="launchers-heading" class="ai-section-title text-center">Open your AI assistant</h2>
      <p class="ai-section-sub text-center mt-3">
        Pick the assistant you already use. We'll load it with the right prompt so it immediately knows how to create your invoice.
      </p>

      <div class="ai-tool-grid mt-10">
        {aiTools.map((tool) => (
          <a
            href={tool.href}
            target="_blank"
            rel="noopener noreferrer"
            class="ai-tool-card"
            aria-label={tool.desc}
          >
            <div class="ai-tool-card-avatar" style={`--tool-color: ${tool.color}`}>
              {tool.letter}
            </div>
            <div class="ai-tool-card-name">{tool.name}</div>
            <div class="ai-tool-card-desc">{tool.desc}</div>
            <svg class="ai-tool-card-arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        ))}
      </div>

      <!-- Copy Prompt box -->
      <div class="ai-copy-box mt-10">
        <div class="ai-copy-box-header">
          <div>
            <p class="ai-copy-box-label">Or copy this prompt into any AI</p>
            <p class="ai-copy-box-hint">Paste it into ChatGPT, Copilot, Claude, or any assistant you like.</p>
          </div>
          <button
            id="copyPromptBtn"
            class="ai-copy-btn"
            type="button"
            aria-label="Copy prompt to clipboard"
          >
            <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true">
              <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span id="copyPromptLabel">Copy prompt</span>
          </button>
        </div>
        <textarea
          id="aiPromptText"
          readonly
          rows="4"
          class="ai-copy-textarea"
          aria-label="AI prompt text"
        >{aiPrompt}</textarea>
      </div>
    </div>
  </section>

  <!-- ░░░ FEATURES GRID ░░░ -->
  <section class="border-t" aria-labelledby="features-heading">
    <div class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
      <p class="eyebrow text-center mb-3">Why it works</p>
      <h2 id="features-heading" class="ai-section-title text-center">You stay in control</h2>

      <div class="ai-features-grid mt-10">
        {features.map((f) => (
          <div class="ai-feature-card">
            <div class="ai-feature-icon">{f.icon}</div>
            <h3 class="ai-feature-title">{f.title}</h3>
            <p class="ai-feature-body">{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ░░░ MCP SECTION ░░░ -->
  <section class="border-t ai-mcp-section" aria-labelledby="mcp-heading">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
      <p class="eyebrow text-center mb-3">For power users</p>
      <h2 id="mcp-heading" class="ai-section-title text-center">Save invoices directly via MCP</h2>
      <p class="ai-section-sub text-center mt-3">
        If your AI assistant supports MCP (Model Context Protocol), connect Best Invoice Generator to save documents directly to your workspace—no copy-pasting needed.
      </p>

      <div class="ai-mcp-steps mt-10">
        <div class="ai-mcp-step">
          <div class="ai-mcp-step-num">1</div>
          <div>
            <p class="ai-mcp-step-title">Open your AI app's settings</p>
            <p class="ai-mcp-step-body">Go to the MCP or "Tools" settings in ChatGPT, Claude, Cursor, or another MCP-capable assistant.</p>
          </div>
        </div>
        <div class="ai-mcp-step">
          <div class="ai-mcp-step-num">2</div>
          <div>
            <p class="ai-mcp-step-title">Add the MCP server URL</p>
            <p class="ai-mcp-step-body">Copy the URL below and paste it as the MCP server endpoint.</p>
          </div>
        </div>
        <div class="ai-mcp-step">
          <div class="ai-mcp-step-num">3</div>
          <div>
            <p class="ai-mcp-step-title">Ask your AI to create an invoice</p>
            <p class="ai-mcp-step-body">Your assistant creates the invoice in your workspace and returns a link to review it.</p>
          </div>
        </div>
      </div>

      <div class="ai-mcp-url-box mt-8">
        <div class="ai-mcp-url-row">
          <label for="mcpServerUrl" class="ai-mcp-url-label">MCP Server URL</label>
          <button id="copyMcpBtn" class="ai-copy-btn" type="button" aria-label="Copy MCP server URL">
            <svg viewBox="0 0 16 16" fill="none" class="h-4 w-4" aria-hidden="true">
              <rect x="5" y="5" width="9" height="9" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
              <path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" stroke="currentColor" stroke-width="1.5"/>
            </svg>
            <span id="copyMcpLabel">Copy</span>
          </button>
        </div>
        <input
          id="mcpServerUrl"
          type="text"
          readonly
          value="https://best-invoicegenerator.com/mcp"
          class="ai-mcp-url-input"
          aria-label="MCP server URL"
        />
      </div>
    </div>
  </section>

  <!-- ░░░ CTA ░░░ -->
  <section class="border-t">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 text-center">
      <div class="ai-cta-glow"></div>
      <h2 class="ai-section-title relative">Ready to create your invoice?</h2>
      <p class="ai-section-sub mt-3 relative">Pick your AI assistant above, describe your invoice in plain English, and get a prefilled link in seconds.</p>
      <div class="relative mt-8 flex flex-wrap justify-center gap-3">
        {aiTools.slice(0, 3).map((tool) => (
          <a
            href={tool.href}
            target="_blank"
            rel="noopener noreferrer"
            class="ai-hero-btn"
            aria-label={`Create invoice with ${tool.name}`}
          >
            <span class="ai-tool-avatar" style={`--tool-color: ${tool.color}`}>{tool.letter}</span>
            <span>{tool.name}</span>
          </a>
        ))}
        <a href="/" class="ai-plain-btn">
          Or build it manually →
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ── */
  .ai-hero {
    background: var(--page-bg);
    min-height: 520px;
    display: flex;
    align-items: center;
  }

  .ai-hero-mesh {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .mesh-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.18;
    animation: blobFloat 12s ease-in-out infinite;
  }

  .mesh-blob-1 {
    width: 520px; height: 520px;
    background: radial-gradient(circle, #7c3aed, #4f46e5);
    top: -120px; left: -80px;
    animation-delay: 0s;
  }

  .mesh-blob-2 {
    width: 400px; height: 400px;
    background: radial-gradient(circle, #6d28d9, #2563eb);
    top: 40px; right: -60px;
    animation-delay: -4s;
  }

  .mesh-blob-3 {
    width: 300px; height: 300px;
    background: radial-gradient(circle, #8b5cf6, #0ea5e9);
    bottom: -60px; left: 40%;
    animation-delay: -8s;
  }

  html.theme-light .mesh-blob { opacity: 0.10; }

  @keyframes blobFloat {
    0%, 100% { transform: translate(0, 0) scale(1); }
    33% { transform: translate(20px, -20px) scale(1.05); }
    66% { transform: translate(-15px, 15px) scale(0.97); }
  }

  .ai-badge {
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.35);
    color: #a78bfa;
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  html.theme-light .ai-badge {
    background: rgba(124, 58, 237, 0.08);
    color: #7c3aed;
  }

  .ai-badge-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #a78bfa;
    box-shadow: 0 0 6px #a78bfa;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  .ai-hero-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text);
  }

  .ai-gradient-text {
    background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 50%, #34d399 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .ai-hero-sub {
    font-size: 1.125rem;
    line-height: 1.75;
    color: var(--muted);
  }

  /* Hero launcher buttons */
  .ai-hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 1px 3px rgb(0 0 0 / .15);
  }

  .ai-hero-btn:hover {
    border-color: #7c3aed;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15), 0 2px 8px rgb(0 0 0 / .2);
    transform: translateY(-1px);
  }

  .ai-hero-arrow {
    width: 14px; height: 14px;
    color: var(--muted);
    transition: transform 0.2s ease;
  }

  .ai-hero-btn:hover .ai-hero-arrow {
    transform: translateX(3px);
    color: #a78bfa;
  }

  .ai-tool-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px; height: 22px;
    border-radius: 6px;
    background: var(--tool-color, #7c3aed);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* ── Chat demo ── */
  .ai-chat-section {
    background: var(--surface);
  }

  .ai-section-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .ai-section-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 36rem;
    margin-left: auto;
    margin-right: auto;
  }

  .ai-chat-window {
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 8px 40px rgb(0 0 0 / .25);
  }

  html.theme-light .ai-chat-window {
    box-shadow: 0 4px 24px rgb(0 0 0 / .08);
  }

  .ai-chat-topbar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    background: var(--surface-raised);
    border-bottom: 1px solid var(--border);
  }

  .chat-dot {
    width: 11px; height: 11px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .ai-chat-label {
    margin-left: 8px;
    font-size: 12px;
    font-weight: 600;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .ai-chat-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--page-bg);
    min-height: 260px;
  }

  .chat-msg {
    display: flex;
    align-items: flex-end;
    gap: 10px;
    opacity: 0;
    transform: translateY(8px);
    animation: chatFadeIn 0.5s ease forwards;
  }

  .chat-msg-user { flex-direction: row-reverse; }

  .chat-line-1 { animation-delay: 0.3s; }
  .chat-line-2 { animation-delay: 1.2s; }
  .chat-line-3 { animation-delay: 2.2s; }
  .chat-line-4 { animation-delay: 3.0s; }
  .chat-line-5 { animation-delay: 4.0s; }

  @keyframes chatFadeIn {
    to { opacity: 1; transform: translateY(0); }
  }

  .chat-avatar-ai {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #7c3aed, #4f46e5);
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
  }

  .chat-bubble {
    max-width: 75%;
    padding: 10px 14px;
    border-radius: 14px;
    font-size: 13.5px;
    line-height: 1.6;
  }

  .chat-bubble-ai {
    background: var(--surface-raised);
    color: var(--text);
    border-bottom-left-radius: 4px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chat-bubble-user {
    background: linear-gradient(135deg, #7c3aed, #4f46e5);
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .chat-link {
    color: #a78bfa;
    font-size: 12px;
    font-family: monospace;
    word-break: break-all;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .chat-tag {
    display: inline-block;
    background: rgba(52, 211, 153, 0.15);
    color: #34d399;
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
  }

  html.theme-light .chat-tag {
    background: rgba(5, 150, 105, 0.1);
    color: #059669;
    border-color: rgba(5, 150, 105, 0.25);
  }

  /* ── Steps ── */
  .ai-steps-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }

  .ai-step-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 16px;
