---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslation, localeHref } from '../i18n';

const lang = 'en';
const t = getTranslation(lang);
const updated = new Intl.DateTimeFormat(lang, { month: 'long', day: 'numeric', year: 'numeric' }).format(new Date());
---

<BaseLayout
  title={t.terms.metaTitle}
  description={t.terms.metaDescription}
  path="terms"
  lang={lang}
  t={t}
>
  <section class="border-b">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow">{t.terms.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.terms.heading}</h1>
      <p class="mt-4 text-sm leading-7 text-zinc-400">
        {t.terms.lastUpdated}
      </p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <article class="text-sm leading-7 text-zinc-400">
        {t.terms.sections.map((s) => (
          <div class="mt-10 first:mt-0">
            <h2 class="text-xl font-semibold tracking-tight text-white">{s.heading}</h2>
            {s.body.map((p) => <p class="mt-3">{p}</p>)}
          </div>
        ))}

        <p class="mt-10">
          {t.terms.contact} <a href={localeHref(lang, 'contact')} class="font-medium text-white underline decoration-zinc-600 underline-offset-4 hover:decoration-white">{t.terms.contactUs}</a>.
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
