---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslation } from '../i18n';

const lang = 'en';
const t = getTranslation(lang);
const contactJs = { openingMail: t.contact.openingMail };
const contactJsJson = JSON.stringify(contactJs);
---

<BaseLayout
  title={t.contact.metaTitle}
  description={t.contact.metaDescription}
  path="contact"
  lang={lang}
  t={t}
>
  <section class="border-b">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow">{t.contact.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.contact.heading}</h1>
      <p class="mt-4 text-sm leading-7 text-zinc-400">{t.contact.intro}</p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <div class="grid gap-8 sm:grid-cols-3">
        <div class="panel">
          <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">{t.contact.email}</p>
          <a href="mailto:support@best-invoicegenerator.com" class="mt-2 block break-all text-sm font-medium text-white underline decoration-zinc-600 underline-offset-4 hover:decoration-white">support@best-invoicegenerator.com</a>
          <p class="mt-2 text-xs text-zinc-400">{t.contact.emailSub}</p>
        </div>
        <div class="panel">
          <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">{t.contact.feedback}</p>
          <p class="mt-2 text-sm text-zinc-300">{t.contact.feedbackSub}</p>
        </div>
        <div class="panel">
          <p class="text-[11px] font-bold uppercase tracking-wider text-zinc-500">{t.contact.response}</p>
          <p class="mt-2 text-sm text-zinc-300">{t.contact.responseSub}</p>
        </div>
      </div>

      <div class="mt-8 panel">
        <h2 class="text-base font-bold tracking-tight text-white">{t.contact.sendMessage}</h2>
        <p class="mt-1 text-xs text-zinc-400">{t.contact.formHint}</p>
        <form id="contactForm" class="mt-5 space-y-4" novalidate>
          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="floating-field">
              <span class="floating-label">{t.contact.name}</span>
              <input id="contactName" name="name" type="text" class="bloom-input" autocomplete="name" />
            </div>
            <div class="floating-field">
              <span class="floating-label">{t.contact.emailLabel}</span>
              <input id="contactEmail" name="email" type="email" class="bloom-input" autocomplete="email" />
            </div>
          </div>
          <div class="floating-field">
            <span class="floating-label">{t.contact.message}</span>
            <textarea id="contactMessage" name="message" rows="5" class="bloom-textarea"></textarea>
          </div>
          <button type="submit" class="button-primary">{t.contact.send}</button>
        </form>
        <p id="contactStatus" role="status" aria-live="polite" class="mt-3 text-xs text-zinc-400"></p>
      </div>

      <div hidden id="big-contact">{contactJsJson}</div>

      <script>
        const I18N = JSON.parse(document.getElementById('big-contact').textContent);
        const contactForm = document.getElementById('contactForm');
        const contactStatus = document.getElementById('contactStatus');
        const contactName = document.getElementById('contactName');
        const contactEmail = document.getElementById('contactEmail');
        const contactMessage = document.getElementById('contactMessage');
        const openingMail = I18N.openingMail;
        contactForm.addEventListener('submit', (e) => {
          e.preventDefault();
          const subject = `Message from ${contactName.value.trim() || 'a visitor'}`;
          const body = `Name: ${contactName.value.trim()}\nEmail: ${contactEmail.value.trim()}\n\n${contactMessage.value.trim()}`;
          location.href = `mailto:support@best-invoicegenerator.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
          contactStatus.textContent = openingMail;
        });
      </script>
    </div>
  </section>
</BaseLayout>
