---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslation } from '../../../i18n';
import { guidesFr, getGuideFr } from '../../../data/guides-fr';
export function getStaticPaths() { return guidesFr.map((guide) => ({ params: { slug: guide.slug } })); }
const guide = getGuideFr(Astro.params.slug ?? '');
if (!guide) return Astro.redirect('/fr/guides/');
const t = getTranslation('fr'); const relatedGuides = guide.related.map(getGuideFr).filter(Boolean); const guidePath = `guides/${guide.slug}`;
const canonicalUrl = `https://best-invoicegenerator.com/fr/${guidePath}/`;
const articleSchema = { '@context': 'https://schema.org', '@type': 'Article', headline: guide.title, description: guide.description, inLanguage: 'fr', dateModified: '2026-09-21', author: { '@type': 'Organization', name: guide.author }, editor: { '@type': 'Organization', name: guide.editor }, mainEntityOfPage: canonicalUrl };
const faqSchema = guide.faq ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: guide.faq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) } : null;
---
<BaseLayout title={`${guide.title} | Best Invoice Generator`} description={guide.description} path={guidePath} lang="fr" t={t} hideLangSwitcher={false} localized={false}>
  <article><header class="border-b border-zinc-800"><div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20"><div class="flex flex-wrap items-center gap-4"><a href="/fr/guides/" class="text-sm font-medium text-zinc-400 hover:text-white">← Tous les guides</a><a href={`/guides/${guide.slug}/`} class="text-sm font-medium text-zinc-500 hover:text-white">Read in English →</a></div><p class="eyebrow mt-8">{guide.category} · {guide.readingTime}</p><h1 class="mt-3 text-4xl font-semibold tracking-tight text-white sm:text-5xl">{guide.title}</h1><p class="mt-6 max-w-3xl text-lg leading-8 text-zinc-400">{guide.summary}</p><dl class="mt-8 flex flex-wrap gap-x-6 gap-y-2 border-t border-zinc-800 pt-5 text-xs leading-6 text-zinc-500"><div><dt class="sr-only">Auteur</dt><dd>Par {guide.author}</dd></div><div><dt class="sr-only">Édition</dt><dd>Édité par {guide.editor}</dd></div><div><dt class="sr-only">Révision</dt><dd>Vérifié le {guide.reviewed}</dd></div></dl></div></header>
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-12 sm:px-6 lg:grid-cols-[minmax(0,1fr)_250px]"><div class="min-w-0">{guide.image && <div class="mb-10 overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-950"><img src={guide.image.src} alt={guide.image.alt} class="h-auto max-h-[420px] w-full object-cover" /></div>}<div class="space-y-5 text-base leading-8 text-zinc-300">{guide.intro.map((paragraph) => <p>{paragraph}</p>)}</div><section class="mt-10 rounded-2xl border border-zinc-800 bg-zinc-950 p-6" aria-labelledby="example-title"><p class="eyebrow">{guide.example.label}</p><h2 id="example-title" class="mt-2 text-xl font-semibold tracking-tight text-white">{guide.example.title}</h2><p class="mt-3 text-sm leading-7 text-zinc-400">{guide.example.body}</p><dl class="mt-5 divide-y divide-zinc-800 border-y border-zinc-800">{guide.example.rows.map(([term, detail]) => <div class="grid gap-1 py-3 sm:grid-cols-[150px_1fr] sm:gap-6"><dt class="text-sm font-medium text-zinc-200">{term}</dt><dd class="text-sm leading-6 text-zinc-400">{detail}</dd></div>)}</dl></section><figure class="mt-10 rounded-2xl border border-zinc-800 bg-zinc-950 p-6" aria-labelledby="diagram-title"><p class="eyebrow">Schéma original</p><h2 id="diagram-title" class="mt-2 text-xl font-semibold tracking-tight text-white">{guide.diagram.title}</h2><ol class="mt-6 grid gap-3 sm:grid-cols-2" aria-label={guide.diagram.title}>{guide.diagram.steps.map((step, index) => <li class="rounded-xl border border-zinc-800 bg-zinc-900/70 p-4 text-sm font-medium text-zinc-200"><span class="mb-3 grid h-6 w-6 place-items-center rounded-full bg-white text-xs font-bold text-zinc-950">{index + 1}</span>{step}</li>)}</ol>{guide.diagram.caption && <figcaption class="mt-4 text-sm leading-6 text-zinc-500">{guide.diagram.caption}</figcaption>}</figure>{guide.sections.map((section) => <section class="mt-12" aria-labelledby={`section-${section.heading.replaceAll(' ', '-').toLowerCase()}`}><h2 id={`section-${section.heading.replaceAll(' ', '-').toLowerCase()}`} class="text-2xl font-semibold tracking-tight text-white">{section.heading}</h2><div class="mt-4 space-y-4 text-base leading-8 text-zinc-300">{section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div>{section.checklist && <ul class="mt-5 space-y-3 rounded-xl border border-zinc-800 bg-zinc-950 p-5 text-sm leading-6 text-zinc-300">{section.checklist.map((item) => <li class="flex gap-3"><span aria-hidden="true" class="font-semibold text-white">✓</span><span>{item}</span></li>)}</ul>}</section>)}{guide.faq && <section class="mt-12 border-t border-zinc-800 pt-10" aria-labelledby="guide-faq"><p class="eyebrow">Questions fréquentes</p><h2 id="guide-faq" class="mt-2 text-2xl font-semibold tracking-tight text-white">Précisions utiles</h2><div class="mt-6 divide-y divide-zinc-800 rounded-xl border border-zinc-800 bg-zinc-950">{guide.faq.map((item) => <details class="group p-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-white">{item.question}<span aria-hidden="true" class="text-lg text-zinc-400 group-open:rotate-45">+</span></summary><p class="pt-4 text-sm leading-7 text-zinc-400">{item.answer}</p></details>)}</div></section>}</div><aside class="h-fit rounded-2xl border border-zinc-800 bg-zinc-950 p-5 lg:sticky lg:top-24" aria-label="Ressources associées"><p class="eyebrow">Utiliser l’outil</p><h2 class="mt-2 text-lg font-semibold text-white">Prêt à créer une facture ?</h2><p class="mt-3 text-sm leading-6 text-zinc-400">Ouvrez le générateur de factures et utilisez ce guide pendant votre vérification.</p><a href="/fr/" class="mt-5 inline-flex w-full items-center justify-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-zinc-950 hover:bg-zinc-200">Créer une facture</a><div class="mt-8 border-t border-zinc-800 pt-5"><p class="eyebrow">Guides associés</p><ul class="mt-3 space-y-3 text-sm leading-6">{relatedGuides.map((related) => related && <li><a href={`/fr/guides/${related.slug}/`} class="text-zinc-300 hover:text-white">{related.title} <span aria-hidden="true">→</span></a></li>)}</ul></div></aside></div>
  </article><script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)}></script>{faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>}
</BaseLayout>
