---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTranslation, localeHref } from '../i18n';

const lang = 'en';
const t = getTranslation(lang);
---

<BaseLayout
  title={t.about.metaTitle}
  description={t.about.metaDescription}
  path="about"
  lang={lang}
  t={t}
>
  <section class="border-b">
    <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.about.heading}</h1>
      <p class="mt-4 text-sm leading-7 text-zinc-400">{t.about.intro}</p>
    </div>
  </section>

  <section>
    <div class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
      <article class="text-sm leading-7 text-zinc-400">
        {t.about.sections.map((s) => (
          <div class="mt-10 first:mt-0">
            <h2 class="text-xl font-semibold tracking-tight text-white">{s.heading}</h2>
            {s.body.map((p) => <p class="mt-3">{p}</p>)}
          </div>
        ))}

        <p class="mt-10 border-t border-zinc-800 pt-6">
          {t.about.contact}
        </p>
      </article>
    </div>
  </section>
</BaseLayout>
