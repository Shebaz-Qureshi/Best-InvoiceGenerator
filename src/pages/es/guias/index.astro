---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getTranslation } from '../../../i18n';
import { guidesEs } from '../../../data/guides-es';

const t = getTranslation('es');
const title = 'Guías prácticas de facturación para una facturación más clara | Best Invoice Generator';
const description = 'Guías originales y prácticas para crear facturas, elegir condiciones de pago, numerar facturas y pasar de un presupuesto al cobro.';

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Guías de facturación',
  itemListElement: guidesEs.map((guide, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://best-invoicegenerator.com/es/guias/${guide.slug}/`,
    name: guide.title,
  })),
};
---

<BaseLayout title={title} description={description} path="guias" lang="es" t={t} hideLangSwitcher={false} localized={true}>
  <section class="border-b border-zinc-800">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
      <p class="eyebrow">Guía de facturación</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-semibold tracking-tight text-white sm:text-5xl">Guías prácticas de facturación, pensadas para el trabajo que realmente envías.</h1>
      <p class="mt-6 max-w-2xl text-base leading-8 text-zinc-400">Explicaciones breves y originales para decisiones comunes de facturación. Cada guía incluye un ejemplo resuelto, un diagrama sencillo y un enlace directo a la herramienta de facturas.</p>
      <a href="/es/" class="mt-8 inline-flex items-center rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-zinc-950 transition hover:bg-zinc-200">Crear una factura <span aria-hidden="true" class="ml-2">→</span></a>
    </div>
  </section>

  <section aria-labelledby="guide-library">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Explora la biblioteca</p>
          <h2 id="guide-library" class="mt-2 text-2xl font-semibold tracking-tight text-white">Empieza por la decisión que tienes delante.</h2>
        </div>
        <p class="max-w-md text-sm leading-6 text-zinc-400">Sin guías genéricas — solo pasos concretos que puedes aplicar en tu próxima factura.</p>
      </div>
      <div class="mt-8 space-y-4">
        {guidesEs.map((guide) => (
          <article class="group relative rounded-2xl border border-zinc-800 bg-zinc-950 p-6 transition hover:-translate-y-0.5 hover:border-zinc-600">
            <div class="flex items-center justify-between gap-4 text-xs text-zinc-500">
              <span class="font-medium text-zinc-300">{guide.category}</span>
              <span>{guide.readingTime}</span>
            </div>
            <h3 class="mt-5 text-xl font-semibold tracking-tight text-white">
              <a href={`/es/guias/${guide.slug}/`} class="hover:text-indigo-400 transition before:absolute before:inset-0 outline-none">
                {guide.title}
              </a>
            </h3>
            <p class="mt-3 text-sm leading-7 text-zinc-400">{guide.summary}</p>
            <div class="mt-6 flex items-center justify-end border-t border-zinc-800 pt-4 text-xs text-zinc-500">
              <a href={`/es/guias/${guide.slug}/`} class="relative z-10 font-medium text-white group-hover:text-indigo-400 transition inline-flex items-center gap-1.5">
                Leer guía <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-zinc-800 bg-zinc-950/60">
    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <p class="text-sm leading-7 text-zinc-400 dark:text-zinc-300 editorial-note">Nota editorial: estas guías ofrecen información general sobre procesos de trabajo, no asesoría fiscal, legal ni contable. Consulta los requisitos aplicables a tu negocio antes de emitir una factura.</p>
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemListSchema)}></script>
</BaseLayout>
